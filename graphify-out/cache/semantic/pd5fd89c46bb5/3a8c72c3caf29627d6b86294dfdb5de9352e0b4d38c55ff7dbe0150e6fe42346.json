{"nodes": [{"id": "user_stories_wiki_users_user_stories", "label": "Users User Stories", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers sign-up, log-in, demo-user guest access, and log-out. Successful sign-up/login auto-authenticates the user; invalid submissions surface field-level validation errors while repopulating all previously-valid entries except the password, so users are not forced to redo correct work. Log-out redirects to a page displaying APIs, framed as a way to keep account information secure."}, {"id": "user_stories_wiki_demo_user_feature", "label": "Demo User Feature", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A clearly visible Demo User button appears on both /signup and /login so an unregistered visitor can log in as a guest and exercise the site's features/functionality without first creating an account or entering credentials."}, {"id": "user_stories_wiki_signup_route", "label": "/signup Page", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_stories_wiki_login_route", "label": "/login Page", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_stories_wiki_home_route", "label": "/ (Home) Page", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_stories_wiki_server_detail_route", "label": "/servers/:serverId Page", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_stories_wiki_servers_crud_user_stories", "label": "Servers CRUD User Stories", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logged-in users see their team servers in a sidebar from /, select one to reach /servers/:serverId and read its description/channels/messages, create new servers via a modal form reachable from either / or /servers/:serverId, update the info of servers they own, and delete owned servers \u2014 deletion explicitly cascades to all associated channels and messages so no orphaned data is left behind."}, {"id": "user_stories_wiki_channels_crud_user_stories", "label": "Channels CRUD User Stories", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Channel operations live entirely on /servers/:serverId: any member can create a channel, all members can view the server's channel list to navigate into a channel's message feed, members can rename channels they belong to, but only the server owner can delete a channel \u2014 mirroring the server-level CRUD pattern while tightening delete permission to ownership."}, {"id": "user_stories_wiki_messages_crud_user_stories", "label": "Messages CRUD User Stories", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Messaging spans two contexts: from / a user picks a friend/online user to start a direct message thread, and from /servers/:serverId a user posts into the selected channel's message feed. Users can view their message threads (from /) or a channel's messages (from /servers/:serverId), and can edit or delete messages they authored to fix typos or retract content."}, {"id": "user_stories_wiki_chat_crud_user_stories", "label": "Chat CRUD User Stories", "file_type": "concept", "source_file": "user_stories_wiki.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chat stories describe the same online-user messaging capability as Messages but framed as 'chat threads': from / or /servers/:serverId a user clicks an online user to start a chat, views chat threads they belong to, and can edit or delete a message they sent in a chat \u2014 largely duplicating the direct-messaging flow already described under Messages."}], "edges": [{"source": "user_stories_wiki_users_user_stories", "target": "user_stories_wiki_signup_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_users_user_stories", "target": "user_stories_wiki_login_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_users_user_stories", "target": "user_stories_wiki_demo_user_feature", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_demo_user_feature", "target": "user_stories_wiki_signup_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_demo_user_feature", "target": "user_stories_wiki_login_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_servers_crud_user_stories", "target": "user_stories_wiki_home_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_servers_crud_user_stories", "target": "user_stories_wiki_server_detail_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_channels_crud_user_stories", "target": "user_stories_wiki_server_detail_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_channels_crud_user_stories", "target": "user_stories_wiki_home_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_messages_crud_user_stories", "target": "user_stories_wiki_home_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_messages_crud_user_stories", "target": "user_stories_wiki_server_detail_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_chat_crud_user_stories", "target": "user_stories_wiki_home_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_chat_crud_user_stories", "target": "user_stories_wiki_server_detail_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_servers_crud_user_stories", "target": "user_stories_wiki_channels_crud_user_stories", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_servers_crud_user_stories", "target": "user_stories_wiki_messages_crud_user_stories", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}, {"source": "user_stories_wiki_messages_crud_user_stories", "target": "user_stories_wiki_chat_crud_user_stories", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "user_stories_wiki.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "user_stories_wiki_resource_crud_pattern", "label": "Resource CRUD User Story Pattern", "nodes": ["user_stories_wiki_servers_crud_user_stories", "user_stories_wiki_channels_crud_user_stories", "user_stories_wiki_messages_crud_user_stories", "user_stories_wiki_chat_crud_user_stories"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "user_stories_wiki.md"}, {"id": "user_stories_wiki_unauthenticated_entry_points", "label": "Unauthenticated Entry Point Pages", "nodes": ["user_stories_wiki_signup_route", "user_stories_wiki_login_route", "user_stories_wiki_demo_user_feature"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "user_stories_wiki.md"}]}