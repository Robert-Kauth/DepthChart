{"nodes": [{"id": "claude_skills_graphify_references_query_graphify_query", "label": "graphify query command + vocab expansion", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_graphify_path", "label": "graphify path command", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_graphify_explain", "label": "graphify explain command", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_vocab_expansion", "label": "Constrained query expansion step", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify query's matcher does case-folded substring + IDF only - no stemming, no synonyms, no cross-language match - so a wording mismatch between the user's question and the graph's node-label vocabulary collapses results to zero; expanding the query against the graph's own extracted vocabulary first (without inventing tokens) fixes this."}, {"id": "claude_skills_graphify_references_query_save_result", "label": "graphify save-result / work-memory feedback loop", "file_type": "concept", "source_file": ".claude/skills/graphify/references/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_query_answer_grounding", "label": "Answer only from graph contents - no hallucinati